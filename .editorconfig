root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.{json,yml,yaml}]
indent_size = 2
[tests/**/*.cs]
# Default-token overloads and independent cancellation are intentional regression inputs.
dotnet_diagnostic.xUnit1051.severity = suggestion
