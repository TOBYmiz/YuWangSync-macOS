<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../YuWangSync.Core/YuWangSync.Core.csproj" /></ItemGroup>
  <Target Name="BuildMacBridge" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../tools/build-native.sh&quot; &quot;$(TargetDir)&quot;" />
  </Target>
  <Target Name="PublishMacBridge" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../tools/build-native.sh&quot; &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
